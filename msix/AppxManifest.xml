<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package for the Microsoft Store. The Store signs the package when it publishes it.
  Identity Name and Publisher, and PublisherDisplayName, must match Partner Center's
  Product management › Product identity page for ServerHat. Publisher is the GuruHat
  account's (the same as AI Meter and ClipHat); check Name once the ServerHat name is
  reserved. The build fills in Version from ServerHat.csproj.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop6 rescap">
  <Identity Name="GuruHat.ServerHat" Publisher="CN=05CD3C36-E7B1-44AF-9610-697D5FFE04B6" Version="0.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>ServerHat</DisplayName>
    <PublisherDisplayName>GuruHat</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Writes go to the real %APPDATA% and registry, not a private copy inside the package:
         scripts and AI agents read %APPDATA%\ServerHat\api-token and edit servers.json, and
         the servers ServerHat starts (npm, node, python) must see the same files and caches
         they do in a terminal. Needs the unvirtualizedResources capability below. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>
  <!-- 2004 (19041) is the first Windows 10 release that honors the desktop6 settings above. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <!-- The languages the app's text is translated into (Strings.cs). The Store lists these
       as the app's languages, and only accepts listings in them. es-mx uses the same
       Spanish as es-es. -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-es" />
    <Resource Language="es-mx" />
    <Resource Language="de-de" />
    <Resource Language="fr-fr" />
    <Resource Language="pt-br" />
    <Resource Language="ja-jp" />
    <Resource Language="zh-cn" />
    <Resource Language="ko-kr" />
  </Resources>
  <Applications>
    <Application Id="ServerHat" Executable="ServerHat.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ServerHat"
        Description="Start, stop and open your local web servers from the Windows notification area, and let Claude Code and Codex run them with your approval."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- "Open ServerHat when I sign in". Off until the user turns it on. -->
        <desktop:Extension Category="windows.startupTask" Executable="ServerHat.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ServerHatStartup" Enabled="false" DisplayName="ServerHat" />
        </desktop:Extension>
        <!-- %LOCALAPPDATA%\Microsoft\WindowsApps\ServerHat.exe, the path Copy for Claude Code
             and Copy for Codex use, because the install folder changes with every update. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="ServerHat.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="ServerHat.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
