<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is part of Windows 10 (1903 and later) and 11, so the app doesn't
         carry a runtime of its own. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Global usings are in Compat.cs: the SDK only generates the Windows Forms ones for .NET 5+. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ServerHat</AssemblyName>
    <RootNamespace>ServerHat</RootNamespace>
    <Version>0.3.0</Version>
    <Product>ServerHat</Product>
    <Company>GuruHat</Company>
    <ApplicationIcon>assets\ServerHat.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>embedded</DebugType>
    <!-- Keep the packages' .xml docs and .pdb files out of the install folder. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- The MSIX startup task API (used by the Microsoft Store version). -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <!-- The app icon at full size, for the About window. -->
    <EmbeddedResource Include="assets\ServerHat.png" LogicalName="ServerHat.png" />
  </ItemGroup>
  <!-- Windows supplies the WinRT metadata at run time; don't copy the .winmd files. -->
  <Target Name="SkipWinmdCopy" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.winmd'" />
    </ItemGroup>
  </Target>
</Project>
